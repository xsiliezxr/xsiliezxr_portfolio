NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5175,http://localhost:8888
# Opcional. Solo si usas requireAuth; el chat público no lo usa.
JWT_SECRET=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Local Express: http://localhost:3000/api
# Netlify prod / netlify dev (mismo origen): /api
VITE_API_URL=/api
# URL pública. Prod: https://www.siliezar.studio
VITE_SITE_URL=
VITE_CONTACT_EMAIL=
VITE_LINKEDIN_URL=
VITE_GITHUB_URL=
VITE_GITHUB_KINAL_URL=
# Solo dígitos con código de país. Ej: 50212345678
VITE_WHATSAPP_NUMBER=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# En Netlify → Site settings → Environment variables (nunca en el repo)
GEMINI_API_KEY=
GROQ_API_KEY=
CHAT_RATE_LIMIT_MAX=12
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_UNKNOWN_MIN=8
CHAT_RATE_LIMIT_DAY_IP=40
CHAT_RATE_LIMIT_DAY_SITE=160
# Local / netlify dev: 1 para no rate-limitar mientras pruebas
CHAT_RATE_LIMIT_DISABLED=
