NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5175
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_chars
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
VITE_API_URL=http://localhost:3000/api
VITE_CONTACT_EMAIL=
VITE_LINKEDIN_URL=
VITE_GITHUB_URL=
VITE_GITHUB_KINAL_URL=
VITE_WHATSAPP_NUMBER=
# gemini | groq. Por defecto gemini.
LLM_PROVIDER=gemini
# Opcional. Vacío usa gemini-2.5-flash o llama-3.3-70b-versatile.
LLM_MODEL=
# Obligatoria solo al pedir el cliente con gemini. Si falta, el chat responde 503.
GEMINI_API_KEY=
# Obligatoria solo al pedir el cliente con groq. Si falta, el chat responde 503.
GROQ_API_KEY=
CHAT_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_WINDOW_MS=60000
